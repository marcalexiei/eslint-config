{
  "name": "@marcalexiei/eslint-config-root",
  "private": true,
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "config"
  ],
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter=\"@marcalexiei/eslint-config\" run build",
    "typecheck": "pnpm --filter=\"@marcalexiei/eslint-config\" run typecheck",
    "lint": "pnpm --filter=\"@marcalexiei/eslint-config\" run lint",
    "test": "pnpm --filter=tests-* run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm run build && changeset publish",
    "validate": "pnpm run build && pnpm run test && pnpm run \"/^(typecheck|format|lint)$/\""
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "prettier": "@marcalexiei/prettier-config",
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/prettier-config": "1.1.4",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  }
}
